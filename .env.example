# Copie para .env e preencha. O .env está no .gitignore: nunca faça commit dele.
# Em dev, o que estiver comentado usa os valores de application-dev.yml.
# Em produção (perfil prod), TODAS as variáveis abaixo são obrigatórias.

# Banco (usado pelo docker-compose.yml)
POSTGRES_DB=marcai
POSTGRES_USER=marcai
POSTGRES_PASSWORD=troque-esta-senha

# Credenciais para obter token da API em POST /oauth2/token (grant client_credentials)
# OAUTH_CLIENT_ID=marcai-painel
# OAUTH_CLIENT_SECRET=gere-um-segredo-longo-e-aleatorio

# WhatsApp Cloud API — painel em developers.facebook.com > seu app > WhatsApp
# Em dev o padrão é o WhatsApp falso (localhost:8089). Para a Meta real em dev, descomente:
# WHATSAPP_API_URL=https://graph.facebook.com/v23.0
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_LEMBRETE=lembrete_agendamento
